# API Configuration
VITE_API_BASE_URL=http://localhost:3000

# n8n Integration
VITE_N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook
VITE_N8N_API_KEY=your_n8n_api_key_here
# Content prep webhook (9606): called after poll webhook finds render URL
VITE_CONTENT_PREP_WEBHOOK_URL=https://your-n8n-instance.com/webhook/content-prep
# Legacy alias for VITE_CONTENT_PREP_WEBHOOK_URL
VITE_SITE_PUBLISH_WEBHOOK_URL=https://your-n8n-instance.com/webhook/content-prep
# WordPress push URL for manual "Publish to site" button
VITE_WORDPRESS_VIDEO_PUSH_URL=https://all-all.ru/wp-json/allall-media-bridge/v1/push-video
# Bearer token for video ingest webhook (Authorization: Bearer <token>)
VITE_SITE_PUBLISH_TOKEN=your_ingest_token_here
# Optional: direct publish target on local site/plugin (overrides n8n publish webhook)
# Example: http://localhost/wp-json/your-plugin/v1/creatomate-result
VITE_LOCAL_SITE_PUBLISH_URL=
# Legacy fallback token variable (if VITE_SITE_PUBLISH_TOKEN is not set)
VITE_LOCAL_SITE_PUBLISH_TOKEN=

# Cloudinary Configuration
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset
VITE_CLOUDINARY_API_KEY=your_api_key

# OpenAI Configuration (для Whisper API)
VITE_OPENAI_API_KEY=sk-your-openai-api-key-here
